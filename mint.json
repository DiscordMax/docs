{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Report Bot",
  "theme": "prism",
  "background": {
    "style": "gradient"
  },
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#E22D2D",
    "light": "#E22D2D",
    "dark": "#E22D2D",
    "anchors": {
      "from": "#E22D2D",
      "to": "#E22D2D"
    }
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "https://discord.gg/reportbot"
    }
  ],
  "topbarCtaButton": {
    "name": "Add to Server",
    "style": "pill",
    "arrow": false,
    "url": "https://reportbot.xyz/invite"
  },
  "anchors": [
    {
      "name": "Website",
      "icon": "browser",
      "url": "https://reportbot.xyz"
    }
  ],
  "navigation": [
    {
      "group": "Information",
      "pages": [
        "introduction",
        "change-log"
      ]
    },
    {
      "group": "Modules",
      "pages": [
        "modules/reporting",
        "modules/tickets",
        "modules/management",
        "modules/moderation",
        "modules/automod",
        "modules/miscellaneous"
      ]
    },
    {
      "group": "Support",
      "pages": [
        "support/faq"
      ]
    }
  ],
  "footerSocials": {
    "website": "http://reportbot.xyz",
    "discord": "https://discord.gg/reportbot"
  }
}